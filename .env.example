# Copy this file to .env and fill in your real credentials.
# Never commit .env — it contains secrets.

# ── Database ──
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── Admin portal ──
SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
PUBLIC_BASE_URL=https://your-service.onrender.com

# ── AI provider ──
# gemini | claude
AI_PROVIDER=gemini

# Gemini key pool. GEMINI_API_KEYS can contain a comma/newline/semicolon-separated
# list with no app-level count cap. Numbered keys are also accepted through _5.
# All unique values are combined in this order: GEMINI_API_KEYS, GEMINI_API_KEY,
# GEMINI_API_KEY_1 ... GEMINI_API_KEY_5.
#
# For a simple five-key Render setup, prefer separate numbered variables and
# leave GEMINI_API_KEYS unset:
#   GEMINI_API_KEY     = key 1
#   GEMINI_API_KEY_1   = key 2
#   GEMINI_API_KEY_2   = key 3
#   GEMINI_API_KEY_3   = key 4
#   GEMINI_API_KEY_4   = key 5
#
# Note: Google applies many Gemini limits at the project/model level, so multiple
# API keys only add independent capacity when the underlying quotas are actually
# independent.
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_API_KEYS=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# The same Gemini pool is used by normal replies, voice transcription, lead
# scoring and follow-up translation. A quota/rate-limit failure immediately
# rotates to another available key. The failed key is skipped during cooldown.
# Short-term rate-limit cooldown default: 60 seconds.
# GEMINI_RATE_LIMIT_COOLDOWN_MS=60000
# Daily-quota-like failures get a longer default cooldown before being tried
# again. This is only used when the provider error clearly indicates a daily/
# quota_exceeded condition; ambiguous 429s use the short rate-limit cooldown.
# GEMINI_QUOTA_COOLDOWN_MS=21600000
# Default temporary provider/network cooldown after retries: 30 seconds.
# GEMINI_UNAVAILABLE_COOLDOWN_MS=30000
# Default cooldown for a rejected/invalid key: 24 hours. A service restart also
# clears in-memory cooldown state, which is appropriate after replacing a key.
# GEMINI_INVALID_KEY_COOLDOWN_MS=86400000
# Main customer-reply model.
GEMINI_MODEL=gemini-2.5-flash
# Capacity fallback for customer replies. If the primary model returns a 503/
# UNAVAILABLE high-demand response, the chatbot switches immediately to the
# fallback model instead of spending another quota-counting request or cycling
# every API key against the same overloaded model.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# A model that returns 503/UNAVAILABLE is skipped for subsequent customer
# replies for 60 seconds by default. This is model-level state, separate from
# individual API-key health. Set 0 to disable; maximum accepted value is 10 min.
# GEMINI_MODEL_UNAVAILABLE_COOLDOWN_MS=60000
# If a Gemini 3.x model is configured, low thinking is used by default for this
# latency-sensitive front-desk workload. Optional override: low | medium | high.
# GEMINI_THINKING_LEVEL=low

# Smart timing for customer-facing Gemini replies. Both Gemini models share the
# same 25-second cap. Normal PR75 key timing remains unchanged: the preferred
# healthy key gets up to 8s; later keys get up to 5s, with adaptive reservation
# for remaining keys. Model fallback uses whatever time remains in that budget.
# GEMINI_REPLY_GLOBAL_BUDGET_MS=25000
# GEMINI_REPLY_PREFERRED_TIMEOUT_MS=8000
# GEMINI_REPLY_FALLBACK_TIMEOUT_MS=5000
# GEMINI_REPLY_MIN_KEY_WINDOW_MS=4000
# Optional: reserve time for the fallback model even when the primary model is
# hanging. Default is 0 so the existing PR75 key timing is preserved.
# GEMINI_REPLY_FALLBACK_MODEL_RESERVE_MS=0
# True 5xx provider failures may retry once after a short 500-1000ms jitter.
# A model-level 503 switches to an available fallback model immediately; if
# there is no fallback model configured, the normal bounded retry still applies.
# GEMINI_REPLY_5XX_RETRY_COUNT=1

# Gemini usageMetadata is recorded automatically for real generation calls:
# customer replies, voice transcription, lead scoring and follow-up translation.
# Setup Status uses the non-generative models.get metadata endpoint instead, so
# running connection checks does not add prompt/output tokens to these totals.
# Only provider/model/purpose/status/token counts/latency are stored; prompts,
# customer messages and API keys are never stored in the usage table.

# These remain fallback-provider controls (for example Claude). Gemini customer
# replies use the global-budget settings above. Other Gemini background tasks
# keep their own existing timing behavior.
AI_REPLY_TIMEOUT_MS=18000
AI_REPLY_RETRY_COUNT=1

# Short quiet window used to combine rapid patient messages such as
# "hi" + "how much hifu" + "for double chin" into one coherent AI reply.
# Values are capped at 3000ms.
AI_REPLY_DEBOUNCE_MS=1200

# Used for date-only business rules such as promotion valid-until dates.
CLINIC_TIMEZONE=Asia/Kuala_Lumpur

# Transcription still uses Gemini even when Claude is the preferred reply
# provider, so keep at least one Gemini key configured if voice notes are enabled.
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# ── Server ──
PORT=10000
NODE_ENV=production

# ── WhatsApp Cloud API ──
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_TOKEN=your_long_lived_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
# WHATSAPP_API_VERSION=v26.0

# ── Facebook Messenger ──
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=

# ── Instagram Messaging ──
# INSTAGRAM_PAGE_ID=
# INSTAGRAM_PAGE_ACCESS_TOKEN=

# Shared Meta webhook verification/signature settings for Facebook + Instagram.
# META_VERIFY_TOKEN=your_meta_webhook_verify_token
# META_APP_SECRET=your_meta_app_secret

# ── Cloudflare R2 media storage ──
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_BASE_URL=https://media.example.com

# ── Telegram alerts ──
TELEGRAM_ALERTS_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Meta Ads enrichment ──
# META_MARKETING_ACCESS_TOKEN=
# META_MARKETING_API_VERSION=v26.0

# ── Optional Claude fallback ──
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-sonnet-5

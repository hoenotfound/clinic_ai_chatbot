# ── WhatsApp Cloud API (from Meta Developer Console > WhatsApp > API Setup) ──
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_test_or_production_phone_number_id
# Found under App Settings > Basic in the Meta Developer Console.
# Used to verify incoming webhooks are genuinely from Meta — strongly
# recommended before exposing this server on a public URL.
WHATSAPP_APP_SECRET=your_app_secret
# Any random string you choose yourself — you'll enter this same value in the
# Meta dashboard when you configure the webhook.
WHATSAPP_VERIFY_TOKEN=choose_any_secret_string_here

# ── Facebook Messenger + Instagram Messaging ──
# These social channels use a separate callback URL: /meta-webhook. Configure
# both under the SAME Meta app so this one META_APP_SECRET can verify webhook
# requests for both channels. META_VERIFY_TOKEN is any random string you choose
# and enter when configuring the Facebook/Instagram webhook subscription.
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=choose_another_secret_string_here

# Facebook Page messaging. The token must be a Page access token with the
# permissions required by Meta for Messenger, including pages_messaging.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Messaging through Messenger from Meta > Instagram settings.
# Generate the Page access token there and use the Facebook Page ID shown for
# the Page linked to the Instagram Professional account. This integration uses
# graph.facebook.com/{PAGE_ID}/messages — it does NOT use an Instagram Login
# authorization code or an Instagram User access token.
INSTAGRAM_PAGE_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=

# ── AI reply engine ──
# Preferred first provider. If its configured attempts fail, the reply engine
# can fall through to the other provider when that provider's key is present.
AI_PROVIDER=gemini

# Claude can be either the preferred provider or a fallback after Gemini.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional model override.
# CLAUDE_MODEL=claude-sonnet-5

# Gemini. A single key continues to work exactly as before.
GEMINI_API_KEY=your_gemini_api_key
# Optional key rotation for quota/rate-limit resilience. You may use either a
# comma/newline-separated list OR numbered variables. Duplicates are removed.
# GEMINI_API_KEYS=key_1,key_2,key_3
# GEMINI_API_KEY_1=your_second_gemini_key
# GEMINI_API_KEY_2=your_third_gemini_key
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# Optional override — check aistudio.google.com for whichever Flash model currently
# has free quota; model names on the free tier change fairly often.
GEMINI_MODEL=gemini-2.5-flash

# Per-provider/key AI reply timeout and same-candidate transient retry count.
# After attempts on one key are exhausted, the engine moves to the next key /
# provider. Invalid or empty structured responses also fall through safely.
AI_REPLY_TIMEOUT_MS=18000
AI_REPLY_RETRY_COUNT=1

# Short quiet window used to combine rapid patient messages such as
# "hi" + "how much hifu" + "for double chin" into one coherent AI reply.
# Values are capped at 3000ms.
AI_REPLY_DEBOUNCE_MS=1200

# Used for date-only business rules such as promotion valid-until dates.
CLINIC_TIMEZONE=Asia/Kuala_Lumpur

# Transcription still uses Gemini even when Claude is the preferred reply
# provider, so keep at least one GEMINI_API_KEY configured if voice notes are enabled.
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# ── Server ──
PORT=3000
# Optional — only needed if your host's proxy setup doesn't let the app
# correctly infer its own public https URL (used to build a link to an
# uploaded promo image for WhatsApp to fetch — see routes/config.js).
# Also used by Telegram alerts to create a direct Inbox link.
# Most hosts (e.g. Render) work fine without setting this for promo images,
# but set it if you want Telegram alerts to include the Inbox link.
# PUBLIC_BASE_URL=https://your-app.onrender.com
# Postgres connection string (e.g. from Neon: Dashboard > Connection Details).
# Use the pooled connection string if offered — safer under concurrent webhook
# traffic. Tables are created automatically on first startup (see src/db/schema.sql).
DATABASE_URL=postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require
# Random long string used to sign staff login session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# ── Telegram alerts (optional) ──
# This one toggle enables both:
# 1) post-conversation lead summaries after the configured inactivity period, and
# 2) immediate Human Intervention Required / channel Delivery Failed alerts.
# Completed score snapshots are queued until the chat is genuinely inactive,
# while human-attention and delivery-failure alerts are sent immediately.
TELEGRAM_ALERTS_ENABLED=false
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Add the bot to the target Telegram group, send a message in the group, then
# use Telegram's getUpdates API or another trusted method to find the group id.
# Group chat ids are commonly negative numbers.
TELEGRAM_CHAT_ID=

# ── Media storage: Cloudflare R2 (from dash.cloudflare.com > R2) ──
# Patient photos/voice notes are uploaded here instead of Postgres.
# Create a bucket, then an R2 API token scoped to Object Read & Write.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=clinic-chatbot-media
# Keep the bucket PRIVATE — bytes are only ever read back server-side by
# authenticated staff routes (see routes/conversations.js), never exposed
# as a public URL.

# ── First staff login (optional) ──
# If no staff logins exist yet, the server creates one automatically from
# these on startup. Useful on hosts with no shell access (e.g. Render's free
# tier) — set these, deploy, then log in and remove them if you like (safe
# to leave set too; this only ever runs once, when the users table is empty).
ADMIN_USERNAME=
ADMIN_PASSWORD=
